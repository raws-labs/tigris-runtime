# ESP32-S3 with PSRAM (developed on an ESP32-S3-DevKitC-1 N16R8: 16 MB flash,
# 8 MB octal PSRAM). The U-Net spills its long-lived skip tensors to PSRAM, so
# PSRAM is required. On a QUAD-PSRAM board, use CONFIG_SPIRAM_MODE_QUAD instead;
# on 8 MB flash, shrink the factory partition in partitions.csv.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# ESP-NN sizes its cache-resident 1x1 filter panel from the configured data
# cache and is written for 64 KB with 64-byte lines; the 32 KB default halves
# the panel and slows every pointwise convolution.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
